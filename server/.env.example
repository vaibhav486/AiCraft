# PostgreSQL / Neon Database Connection String (pgvector 0.8.0+ supported)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Google Gemini API Key (used for LLM completion and gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# Clipdrop & Cloudinary (existing image tools)
CLIPDROP_API_KEY=your_clipdrop_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# RAG & Vector Search Configuration
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=30
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.25
MAX_PDF_SIZE_MB=10
RAG_LLM_MODEL=gemini-3.5-flash-lite
PORT=3000
